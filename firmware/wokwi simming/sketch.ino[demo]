#include <ESP32Servo.h>

// object definitions
Servo thumb;
Servo indexFinger;
Servo middleFinger;
Servo ringFinger;
Servo pinkyFinger;

// Define GPIO pins
const int PIN_THUMB = 12;
const int PIN_INDEX = 13;
const int PIN_MIDDLE = 14;
const int PIN_RING = 27;
const int PIN_PINKY = 26;

void setup() {
  thumb.attach(PIN_THUMB);
  indexFinger.attach(PIN_INDEX);
  middleFinger.attach(PIN_MIDDLE);
  ringFinger.attach(PIN_RING);
  pinkyFinger.attach(PIN_PINKY);
}

void loop() {
  // Open hand(random angle chosen just for example)
  thumb.write(-10);
  indexFinger.write(-10);
  middleFinger.write(-10);
  ringFinger.write(-10);
  pinkyFinger.write(-10);
  delay(1000);

  // Close hand
  thumb.write(+5);
  indexFinger.write(+5);
  middleFinger.write(+5);
  ringFinger.write(+5);
  pinkyFinger.write(+5);
  delay(1000);
}
